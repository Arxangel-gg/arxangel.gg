# ============================================================================
# ARXANGEL — Netlify headers (honored when this folder is the publish dir)
# Caching strategy: long-lived static assets, always-revalidate HTML.
# NOTE: framing is intentionally LEFT OPEN (no X-Frame-Options) so the site can
#       be embedded inside Carrd. Do not add frame-ancestors restrictions.
# ============================================================================

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: browsing-topics=(), interest-cohort=()
  X-DNS-Prefetch-Control: on

# HTML: never trust the cache, always revalidate (so updates show immediately).
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# CSS / JS / data: always revalidate so edits (config.js, releases.json) show up
# the moment you redeploy — no stale modules. Unchanged files return a cheap 304.
/css/*
  Cache-Control: public, max-age=0, must-revalidate
/js/*
  Cache-Control: public, max-age=0, must-revalidate
/data/*
  Cache-Control: public, max-age=0, must-revalidate

# Immutable-ish assets: cache hard for a year (filenames are stable).
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/media/*
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable
